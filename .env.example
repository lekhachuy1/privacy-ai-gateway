APP_SECRET=change-this-secret-before-demo
DATABASE_PATH=data/privacy_gateway.db

# mock | gemini | ollama | hybrid
AI_MODE=gemini
AI_DEFAULT_PROVIDER=gemini
AI_SENSITIVE_PROVIDER=ollama
AI_FALLBACK_PROVIDER=mock
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=4000

# Lấy key tại https://aistudio.google.com/apikey và chỉ đặt trong .env, không commit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=4096

MEMORY_ENABLED=true
MEMORY_RETENTION_DAYS=7
MEMORY_RECENT_MESSAGES=6
CROSS_SESSION_MEMORY_ENABLED=true
CROSS_SESSION_MEMORY_MESSAGES=4

# Khóa riêng để mã hóa Token Vault. Hãy thay bằng chuỗi ngẫu nhiên dài và
# không commit file .env lên Git.
TOKEN_VAULT_KEY=change-this-token-vault-key-before-demo

# Localhost: false. Khi triển khai HTTPS phải đặt true và đổi APP_SECRET.
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# Mật khẩu tài khoản demo (mặc định demo123); đổi khi không chạy cục bộ.
DEMO_PASSWORD=demo123

# Ghi nguyên văn payload gửi tới Gemini/Ollama vào data/egress.log để chứng minh khi demo.
EGRESS_LOG_ENABLED=false
